# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term alacritty
set $config_dir ~/.config/sway
set $scripts $config_dir/scripts

# Hide tiled window titles and show them on floating windows.
default_border none
default_floating_border normal 0

# Decoration colors match the dark/blue Quickshell theme.
# class                 border  background text    indicator child_border
client.focused          #7ebae4 #1b1b1b #eeeeee #7ebae4 #7ebae4
client.focused_inactive #444444 #1b1b1b #bfbfbf #444444 #444444
client.unfocused        #333333 #1b1b1b #9a9a9a #333333 #333333
client.urgent           #e5b567 #1b1b1b #eeeeee #e5b567 #e5b567

gaps inner 5

### Output configuration
#
# Default wallpaper (more resolutions are available in /run/current-system/sw/share/backgrounds/sway/)
# output * bg /run/current-system/sw/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png fill
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

# Make Sway's session environment available to D-Bus and systemd user services.
exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_SESSION_TYPE
# Restart the clipboard picker after importing Sway's environment.
exec sh -c 'systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK; \
    systemctl --user restart clipboard-picker.service'

# Restore the wallpaper independently of the clipboard picker.
exec sh -c 'systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK; \
    bash "$HOME/.config/sway/scripts/wallpaper.sh" --restore'

exec waybar -c ~/.config/waybar/config.jsonc -s ~/.config/waybar/styles.css
exec qs -c wallpaper-picker
exec qs -c capture
exec qs -c dock
exec qs -c app-switcher
exec swayosd-server

# Shift from 6500K to 4000K using GeoClue-based sunrise and sunset times.
exec gammastep -m wayland -l geoclue2 -t 6500:4000

# open-many automatically starts the Eww daemon if it is not running.
exec eww open-many widgets calendar-window

exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

exec autotiling

### Idle configuration
# Lock after 5 minutes; power off displays after 10 and restore them on activity.
# Waybar's eye icon pauses idle actions, but not manual or before-sleep locking.
exec swayidle -w \
    timeout 300 '"$HOME/.config/sway/scripts/lockscreen.sh"' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '"$HOME/.config/sway/scripts/lockscreen.sh"'

### Input configuration
#
# Example configuration:
#
#   input "2:14:SynPS/2_Synaptics_TouchPad" {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.

input * {
    xkb_layout us
    xkb_variant mac
    # Use Left Alt for macOS-style accent sequences.
    xkb_options lv3:lalt_switch
    repeat_delay 250
    repeat_rate 50
}

# Use the configured dark cursor in Sway itself.
seat seat0 xcursor_theme Bibata-Modern-Classic 24

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+q kill

    # lock screen using a video as wallpaper
    bindsym $mod+Ctrl+q exec $scripts/lockscreen.sh

    # Start rofi (a program launcher)
    bindsym $mod+space exec rofi -show drun -show-icons

    # Switch between open windows across workspaces
    bindsym $mod+Tab nop app-switcher-next
    bindsym $mod+Shift+Tab nop app-switcher-previous
    bindsym --release Super_L nop app-switcher-accept
    bindsym --release Super_R nop app-switcher-accept
    bindsym --release Shift+Super_L nop app-switcher-accept
    bindsym --release Shift+Super_R nop app-switcher-accept

    # Open frequently used desktop actions
    bindsym $mod+Shift+space exec ~/.config/sway/scripts/quick-actions.sh

    # Open the emoji picker with the macOS shortcut: Control+Command+Space
    bindsym Ctrl+$mod+space exec rofimoji --selector rofi --action type --typer wtype

    # Hold Left Alt+Space for offline push-to-talk transcription.
    bindsym --no-repeat Mod5+space exec handy --toggle-transcription
    bindsym --release Mod5+space exec handy --toggle-transcription

    # Switch tabs with macOS-style Command+Shift+[ and Command+Shift+].
    bindsym $mod+Shift+bracketleft exec wtype -M ctrl -P Page_Up -p Page_Up -m ctrl
    bindsym $mod+Shift+bracketright exec wtype -M ctrl -P Page_Down -p Page_Down -m ctrl

    # Magnify a frozen capture of the screen; scroll to zoom and Escape to exit.
    bindsym $mod+z exec woomer

    # Enter a keyboard pointer mode for scrolling and clicking.
    bindsym $mod+Shift+g mode "Mouse"
    mode "Mouse" {
        bindsym j exec wlrctl pointer scroll 10 0
        bindsym k exec wlrctl pointer scroll -10 0
        bindsym h exec wlrctl pointer scroll 0 -10
        bindsym l exec wlrctl pointer scroll 0 10
        bindsym --no-repeat g mode "Mouse Go"
        bindsym --no-repeat Shift+g exec wtype -P End -p End
        bindsym --no-repeat s exec wlrctl pointer click left
        bindsym --no-repeat d exec wlrctl pointer click middle
        bindsym --no-repeat f exec wlrctl pointer click right
        bindsym Escape mode default
    }

    mode "Mouse Go" {
        bindsym --no-repeat g exec wtype -P Home -p Home, mode "Mouse"
        bindsym Escape mode "Mouse"
    }

    # Open clipboard history with the compiled C picker.
    bindsym $mod+y exec "$HOME/dotfiles/clipboard-picker/result/bin/clipboard-picker"

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+Up focus up
    bindsym $mod+$right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen (macOS-style Control+Command+F)
    bindsym Ctrl+$mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+f floating toggle

    # Swap focus between the tiling area and the floating area
    # bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent

    # Hide the focused window in the scratchpad or show a scratchpad window
    bindsym $mod+Shift+minus move scratchpad
    bindsym $mod+minus scratchpad show

# Resizing containers:
#
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Return to default mode
    bindsym $mod+r mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities:
#
    # Special keys to adjust volume via PulseAudio
    bindsym --locked XF86AudioMute exec swayosd-client --output-volume mute-toggle
    bindsym --locked XF86AudioLowerVolume exec swayosd-client --output-volume -5
    bindsym --locked XF86AudioRaiseVolume exec swayosd-client --output-volume +5
    bindsym --locked XF86AudioMicMute exec bash $scripts/microphone-mute.sh
    bindsym XF86AudioPlay exec playerctl play-pause
    bindsym XF86AudioNext exec playerctl next
    bindsym XF86AudioPrev exec playerctl previous
    # Special keys to adjust brightness via brightnessctl
    bindsym --locked XF86MonBrightnessDown exec swayosd-client --brightness -5
    bindsym --locked XF86MonBrightnessUp exec swayosd-client --brightness +5
    # Capture toolbar and recording stop shortcut
    bindsym $mod+Shift+s exec qs -c capture ipc call capture toggle
    bindsym $mod+Ctrl+s exec qs -c capture ipc call capture stop

# Enable services so sway can run with no errors, this is required to be able to run waybar
# because we need to have xdg-portal service enabled
include /etc/sway/config.d/*

for_window [app_id="^com.erick.ClipboardPicker$"] floating enable, move position center
for_window [app_id="^com.erick.WallpaperPicker$"] floating enable, move position center
for_window [app_id="org.gnome.NautilusPreviewer"] floating enable, move position center, resize set 900 700
for_window [app_id="^qimgv$"] floating enable
for_window [class="^qimgv$"] floating enable
for_window [app_id="^blueman-manager$"] floating enable, move position center
for_window [class="^Blueman-manager$"] floating enable, move position center
for_window [app_id="^nm-connection-editor$"] floating enable, move position center
for_window [class="^Nm-connection-editor$"] floating enable, move position center
for_window [app_id="^org.pulseaudio.pavucontrol$"] floating enable, border normal 2, move position center
for_window [app_id="^pavucontrol$"] floating enable, border normal 2, move position center
for_window [class="^Pavucontrol$"] floating enable, border normal 0, move position center

for_window [app_id="^firefox$"] move to workspace 2
for_window [app_id="^helium$"] move to workspace 2
for_window [class="^Emacs$"] move to workspace 3
for_window [class="^Spotify$"] move to workspace 4
